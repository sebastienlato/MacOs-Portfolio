# Served by Hostinger (LiteSpeed), which reads Apache directives. Vite copies
# this into dist/ with the rest of public/, so it deploys with the site.
#
# Everything is wrapped in <IfModule>: an unknown directive in .htaccess is a
# 500 for the whole site, and a missing header is not.

# A module worker only starts from a JavaScript MIME type, and the default for
# .mjs here is text/plain.
<IfModule mod_mime.c>
  AddType text/javascript .mjs
</IfModule>

<IfModule mod_setenvif.c>
  # Vite puts a content hash in every filename under /assets/, so a changed
  # file is a new URL and the old one can be cached for good.
  SetEnvIf Request_URI "^/assets/" HASHED_ASSET
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=HASHED_ASSET

  # The entry document names those hashed files, so it has to be revalidated or
  # a deploy is invisible until the browser's copy expires.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
